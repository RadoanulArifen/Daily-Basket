# /etc/systemd/system/vibe-queue.service
# Sends emails in the background. Restarted automatically; deploy.sh reloads it after each update.

[Unit]
Description=Vibe Ecommerce queue worker
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/vibe-ecommerce
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
