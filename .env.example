# ---------------------------------------------------------------------------
# Daily Basket — environment settings. Copy this file to .env and fill it in.
# Every value here is a placeholder: never commit a real .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Store name used in page titles, emails and the admin.
APP_NAME="Daily Basket"
# local while developing, production on a live server.
APP_ENV=local
# Encryption key. Leave empty here; "php artisan key:generate" fills it in.
APP_KEY=
# true shows error details. Always false on a live server.
APP_DEBUG=true
# The exact address you open the site at (no trailing slash). Image links are built from it.
APP_URL=http://127.0.0.1:8000
# Old APP_KEY values (comma-separated) still accepted for decryption after you rotate the key.
APP_PREVIOUS_KEYS=
# Where "php artisan down" keeps its flag: file (one server) or cache (several servers).
APP_MAINTENANCE_DRIVER=file

# --- Languages, currency, theme ---------------------------------------------
# Default admin/app language.
APP_LOCALE=en
# Language used when a translation is missing.
APP_FALLBACK_LOCALE=en
# Locale for demo data generated by factories.
APP_FAKER_LOCALE=en_US
# Storefront languages, comma-separated: en, ar or en,ar (Arabic is right-to-left).
STORE_LOCALES=en
# Base currency (ISO code). More display currencies are added in Admin → Settings → Currencies.
STORE_CURRENCY=USD
# The store's own country (ISO code), pre-selected on address forms until Settings → Shipping
# → Default country names one. Customers' countries: Settings → Shipping → Countries.
STORE_COUNTRY=US
# Storefront theme folder in resources/themes/<name>: furnivo (furniture) or freshnest
# (organic grocery). Empty = the built-in base theme. Run npm run build after changing it.
STORE_THEME=freshnest
# Time zone used to show dates and times in the admin and emails.
STORE_TIMEZONE=America/Los_Angeles
# Prefix for order numbers, e.g. FN-1001.
ORDER_NUMBER_PREFIX=FN-
# Unpaid card orders are cancelled (and stock released) after this many minutes.
UNPAID_ORDER_MINUTES=60

# --- Admin panel ------------------------------------------------------------
# URL path of the admin panel, e.g. admin → https://your-shop.com/admin
ADMIN_PATH=admin
# The Super Admin created by "php artisan db:seed".
ADMIN_NAME="Store Owner"
ADMIN_EMAIL=admin@example.com
# IMPORTANT: leave empty and "php artisan db:seed" generates a strong random password
# (16 characters, with symbols) and prints it ONCE in the terminal — copy it immediately
# and store it safely. Or set your own: at least 8 characters with a letter, a number and
# a symbol — a weak password here is a security risk. Change it before going live either way.
ADMIN_PASSWORD=

# --- Public demo (leave off for a real shop) --------------------------------
# true = read-only admin: every change is refused and the database resets hourly.
DEMO_MODE=false
# Enable one-click, read-only role previews on localhost or a DEMO_MODE site.
DEMO_ROLE_LOGIN=false
# Only used when DEMO_MODE=true. Set strong credentials before enabling demo mode.
# Sign-in shown on the admin login page while DEMO_MODE=true. Required when DEMO_MODE=true:
# "php artisan store:demo-admin" refuses to run without both, and then creates a separate
# Manager account (never the owner) with exactly these details; the password must be at least
# 8 characters with a letter and a number. Unused when DEMO_MODE=false.
DEMO_EMAIL=
# Required only when DEMO_MODE=true: a strong password (16+ characters with symbols).
# Left empty on purpose — store:demo-admin refuses to run until you set one.
DEMO_PASSWORD=
# Role of the demo account: owner (every screen, read-only) or manager / orders / content.
DEMO_ROLE=owner
# Let search engines index the /landing/ page and list it in the sitemap.
LANDING_INDEXABLE=false
# Other sites that may show the landing page and storefront in an iframe, e.g. a marketplace
# demo frame: "https://vibe96.com https://www.vibe96.com". Empty = this site only. The admin
# can never be framed.
ALLOW_FRAMING_FROM=

# --- Database (MySQL 8.0+) --------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freshnest
DB_USERNAME=freshnest
# REQUIRED: generate a strong password with: openssl rand -base64 24
# Left empty on purpose (fails closed): Docker will not start and store:launch-check fails
# until you set it.
# REQUIRED for production: set a strong, unique database password (20+ random characters,
# e.g. `openssl rand -base64 24`). Never leave it empty on a live server; the placeholder below
# is empty and "php artisan store:launch-check" fails until it is set.
DB_PASSWORD=
# Optional: a unix socket instead of host/port, and a CA file for SSL connections.
DB_SOCKET=
MYSQL_ATTR_SSL_CA=

# --- Sessions, cache, queue -------------------------------------------------
# database keeps everything in MySQL, so the app also runs on shared/cPanel hosting.
SESSION_DRIVER=database
# Minutes of inactivity before a session ends.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie domain, e.g. .your-shop.com. null = the current host.
SESSION_DOMAIN=null
# true on HTTPS sites (recommended in production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
# Prefix for cache keys (only matters if several apps share one cache).
CACHE_PREFIX=
# sync sends emails immediately (development). database + the queue worker in production.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# --- Files ------------------------------------------------------------------
FILESYSTEM_DISK=local
# Disk for uploaded images: public (storage/app/public) or s3.
STORE_UPLOAD_DISK=public
# Public address of uploads. /storage works with "php artisan storage:link".
STORAGE_URL=/storage
# Only when STORE_UPLOAD_DISK=s3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug while developing, error in production.
LOG_LEVEL=debug

# --- Email ------------------------------------------------------------------
# log writes emails to storage/logs/laravel.log. Use smtp for real sending
# (Gmail steps: docs/deployment.md → "Email with Gmail"). Also editable in Admin → Settings.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Card payments (Stripe) — also editable in Admin → Settings → Credentials --
# Get test keys at https://dashboard.stripe.com/test/apikeys (pk_test_… and sk_test_…).
# Webhook: add an endpoint https://your-domain/webhooks/stripe at
# https://dashboard.stripe.com/test/webhooks and copy its signing secret (whsec_…).
# Test keys start with pk_test_ / sk_test_; live keys with pk_live_ / sk_live_.
STRIPE_KEY=
STRIPE_SECRET=
# From Stripe Dashboard → Developers → Webhooks (endpoint: /webhooks/stripe). Starts with whsec_.
STRIPE_WEBHOOK_SECRET=

# --- Aramex delivery rates (optional) — also editable in the admin -----------
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
# Aramex entity and country of your account, e.g. DXB / AE.
ARAMEX_ACCOUNT_ENTITY=DXB
ARAMEX_ACCOUNT_COUNTRY=AE

# --- Spam protection (Google reCAPTCHA v3, optional) ------------------------
# For the contact and custom-order forms. Also editable in Admin → Settings → Mail server & security.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# 0.0–1.0: submissions scoring below this are rejected.
RECAPTCHA_MIN_SCORE=0.5

# --- Security & build -------------------------------------------------------
# Password hashing cost (higher = slower and stronger).
BCRYPT_ROUNDS=12
# Passed to the front-end build.
VITE_APP_NAME="${APP_NAME}"
